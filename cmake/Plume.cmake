# Build only the native Metal backend. No Vulkan loader, MoltenVK or SDK fork.
if(NOT APPLE)
  message(FATAL_ERROR "BLUR_PLUME_RENDERER currently supports macOS/Metal only")
endif()
set(BLUR_PLUME_SOURCE_DIR "${PROJECT_SOURCE_DIR}/local/plume" CACHE PATH "Pinned Plume source")
file(READ "${PROJECT_SOURCE_DIR}/recomp/plume-pin.json" _plume_pin)
string(JSON _plume_count LENGTH "${_plume_pin}" files)
math(EXPR _plume_last "${_plume_count} - 1")
foreach(i RANGE 0 ${_plume_last})
  string(JSON _plume_file MEMBER "${_plume_pin}" files ${i})
  string(JSON _plume_hash GET "${_plume_pin}" files "${_plume_file}")
  if(NOT EXISTS "${BLUR_PLUME_SOURCE_DIR}/${_plume_file}")
    message(FATAL_ERROR "Missing pinned Plume source. Run: python3 tools/setup_plume.py")
  endif()
  file(SHA256 "${BLUR_PLUME_SOURCE_DIR}/${_plume_file}" _actual_hash)
  if(NOT _actual_hash STREQUAL _plume_hash)
    message(FATAL_ERROR "Plume source differs from pin: ${_plume_file}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${BLUR_PLUME_SOURCE_DIR}/${_plume_file}")
endforeach()
enable_language(OBJCXX)
set(_plume_build "${CMAKE_CURRENT_BINARY_DIR}/plume-source")
execute_process(COMMAND ${Python3_EXECUTABLE} "${PROJECT_SOURCE_DIR}/tools/prepare_plume.py"
  "${BLUR_PLUME_SOURCE_DIR}" "${_plume_build}" COMMAND_ERROR_IS_FATAL ANY)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${PROJECT_SOURCE_DIR}/tools/prepare_plume.py" "${PROJECT_SOURCE_DIR}/recomp/plume-pin.json")
add_library(blur-plume-rhi STATIC
  "${_plume_build}/plume_metal.cpp"
  "${_plume_build}/plume_apple.mm")
target_include_directories(blur-plume-rhi SYSTEM PUBLIC "${_plume_build}")
target_include_directories(blur-plume-rhi SYSTEM PRIVATE "${BLUR_PLUME_SOURCE_DIR}/contrib/metal-cpp")
target_compile_options(blur-plume-rhi PRIVATE -fblocks)
target_compile_definitions(blur-plume-rhi PRIVATE PLUME_APPLE_RETINA_ENABLED)
target_link_libraries(blur-plume-rhi PUBLIC
  "-framework Metal" "-framework QuartzCore" "-framework Foundation"
  "-framework AppKit" "-framework IOKit")

set(_shader_dir "${CMAKE_CURRENT_BINARY_DIR}/plume-shaders")
add_custom_command(OUTPUT "${_shader_dir}/native_shaders.hpp"
  COMMAND ${CMAKE_COMMAND} -E make_directory "${_shader_dir}"
  COMMAND ${Python3_EXECUTABLE} "${PROJECT_SOURCE_DIR}/tools/embed_native_shaders.py"
    "${PROJECT_SOURCE_DIR}/src/render/native.metal" "${_shader_dir}/native_shaders.hpp"
  DEPENDS src/render/native.metal tools/embed_native_shaders.py VERBATIM)
add_library(blur-render STATIC src/render/renderer.cpp "${_shader_dir}/native_shaders.hpp")
target_include_directories(blur-render PUBLIC src PRIVATE "${_shader_dir}")
target_link_libraries(blur-render PRIVATE blur-plume-rhi)
target_compile_options(blur-render PRIVATE -Wall -Wextra -Wpedantic)
add_executable(blur-plume src/render/plume_main.cpp)
target_link_libraries(blur-plume PRIVATE blur-render SDL3::SDL3)
target_compile_options(blur-plume PRIVATE -Wall -Wextra -Wpedantic)
add_executable(blur-render-tests tests/render/renderer_tests.cpp)
target_link_libraries(blur-render-tests PRIVATE blur-render)
add_test(NAME native-render-contract COMMAND blur-render-tests --cpu-only)
option(BLUR_PLUME_GPU_TESTS "Run real offscreen Metal draw/readback tests (requires GPU access)" OFF)
if(BLUR_PLUME_GPU_TESTS)
  add_test(NAME native-render-gpu COMMAND blur-render-tests)
endif()
add_test(NAME plume-help COMMAND blur-plume --help)

option(BLUR_PLUME_GUEST_ADAPTER "Build bounded Xbox guest UI shader/resource adapter" ON)
if(BLUR_PLUME_GUEST_ADAPTER)
  add_library(blur-guest-render STATIC src/render/guest_draw.cpp)
  target_include_directories(blur-guest-render PUBLIC src)
  target_link_libraries(blur-guest-render PRIVATE blur-plume-rhi blur-guest-packet)
  if(TARGET rexmetal-spirv-cross)
    # Use the same pinned sources as the SDK; provide the public include layout.
    set(BLUR_SPIRV_CROSS_INCLUDE_DIR "${CMAKE_CURRENT_BINARY_DIR}/spirv-cross-include")
    file(MAKE_DIRECTORY "${BLUR_SPIRV_CROSS_INCLUDE_DIR}")
    file(CREATE_LINK "${REXGLUE_METAL_DEPS_ROOT}/spirv-cross"
      "${BLUR_SPIRV_CROSS_INCLUDE_DIR}/spirv_cross" SYMBOLIC)
    target_link_libraries(blur-guest-render PRIVATE rexmetal-spirv-cross)
  else()
    find_path(BLUR_SPIRV_CROSS_INCLUDE_DIR spirv_cross/spirv_msl.hpp REQUIRED)
    find_library(BLUR_SPIRV_CROSS_MSL spirv-cross-msl REQUIRED)
    find_library(BLUR_SPIRV_CROSS_GLSL spirv-cross-glsl REQUIRED)
    find_library(BLUR_SPIRV_CROSS_CORE spirv-cross-core REQUIRED)
    target_link_libraries(blur-guest-render PRIVATE "${BLUR_SPIRV_CROSS_MSL}"
      "${BLUR_SPIRV_CROSS_GLSL}" "${BLUR_SPIRV_CROSS_CORE}")
  endif()
  target_include_directories(blur-guest-render PRIVATE "${BLUR_SPIRV_CROSS_INCLUDE_DIR}")
  target_compile_options(blur-guest-render PRIVATE -Wall -Wextra -Wpedantic)
  add_executable(blur-plume-guest tools/plume_guest_replay.cpp)
  target_link_libraries(blur-plume-guest PRIVATE blur-guest-render blur-guest-packet)
  # Export one C entry point only; keep the renderer and SPIRV-Cross C++ symbols
  # private when loaded beside the Xbox SDK's existing libraries.
  add_library(blur-plume-bridge SHARED src/render/plume_bridge.cpp)
  target_include_directories(blur-plume-bridge PRIVATE src)
  target_link_libraries(blur-plume-bridge PRIVATE blur-guest-render blur-guest-packet)
  target_compile_options(blur-plume-bridge PRIVATE -Wall -Wextra -Wpedantic)
  set_target_properties(blur-plume-bridge PROPERTIES CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
  target_link_options(blur-plume-bridge PRIVATE "LINKER:-exported_symbols_list,${PROJECT_SOURCE_DIR}/src/render/plume_bridge.exports")
  set_property(TARGET blur-plume-bridge APPEND PROPERTY LINK_DEPENDS "${PROJECT_SOURCE_DIR}/src/render/plume_bridge.exports")
  enable_language(C)
  add_library(blur-bridge-c-header OBJECT tests/render/bridge_header_test.c)
  target_include_directories(blur-bridge-c-header PRIVATE src)
  add_executable(blur-plume-bridge-tests tests/render/bridge_tests.cpp)
  target_include_directories(blur-plume-bridge-tests PRIVATE src)
  add_executable(blur-plume-bridge-host tools/plume_bridge_host.cpp)
  target_include_directories(blur-plume-bridge-host PRIVATE src)
  add_test(NAME guest-bridge-contract COMMAND blur-plume-bridge-tests $<TARGET_FILE:blur-plume-bridge>)
  add_test(NAME guest-bridge-help COMMAND blur-plume-bridge-host --help)
  add_test(NAME guest-replay-help COMMAND blur-plume-guest --help)
  option(BLUR_REX_PLUME_FRONTEND "Build register-state mapping against the pinned reference SDK" OFF)
  if(BLUR_REX_PLUME_FRONTEND)
    include(cmake/RexPlumeFrontend.cmake)
  endif()
  if(BLUR_PLUME_GPU_TESTS)
    add_test(NAME guest-gpu-readback COMMAND blur-plume-guest --self-test)
  endif()
endif()
