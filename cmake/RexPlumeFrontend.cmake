# Optional CPU frontend only. Never modifies or links the reference GPU plugin.
set(BLUR_REX_SDK_SOURCE_DIR "${PROJECT_SOURCE_DIR}/local/x360-feasibility/internal-workspaces-20261025/blur-metal-candidate-20261026/sdk"
  CACHE PATH "Reference SDK source for the Plume register mapper")
file(READ "${PROJECT_SOURCE_DIR}/recomp/rex-plume-state-pin.json" _rex_state_pin)
string(JSON _count LENGTH "${_rex_state_pin}" files)
math(EXPR _last "${_count}-1")
foreach(i RANGE 0 ${_last})
  string(JSON _name MEMBER "${_rex_state_pin}" files ${i})
  string(JSON _expected GET "${_rex_state_pin}" files "${_name}")
  if(NOT EXISTS "${BLUR_REX_SDK_SOURCE_DIR}/${_name}")
    message(FATAL_ERROR "Missing pinned SDK register source: ${_name}")
  endif()
  file(SHA256 "${BLUR_REX_SDK_SOURCE_DIR}/${_name}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "SDK state definitions/policy changed: ${_name}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${BLUR_REX_SDK_SOURCE_DIR}/${_name}")
endforeach()
