# Source-only Metal backend plus bounded Plume hooks. Included by the local host.
if(NOT APPLE OR NOT TARGET rexgpu-xenos)
  message(FATAL_ERROR "Metal/Plume requires macOS and the patched source SDK (REXSDK_DIR)")
endif()
set(_blur_root "${BLURCOMPILED_SOURCE_DIR}")
if(NOT EXISTS "${_blur_root}/recomp/metal/sdk-pin.json")
  message(FATAL_ERROR "Set BLURCOMPILED_SOURCE_DIR to your BlurCompiled checkout")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${_blur_root}/recomp/metal/sdk-pin.json" "${_blur_root}/tools/instrument_metal.py")
file(READ "${_blur_root}/recomp/metal/sdk-pin.json" _pin)
string(JSON _count LENGTH "${_pin}" files)
math(EXPR _last "${_count}-1")
foreach(i RANGE 0 ${_last})
  string(JSON _name MEMBER "${_pin}" files ${i})
  string(JSON _expected GET "${_pin}" files "${_name}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${REXSDK_DIR}/${_name}")
  file(SHA256 "${REXSDK_DIR}/${_name}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Patched Metal SDK pin mismatch: ${_name}")
  endif()
endforeach()
foreach(_dependency libvulkan.1.dylib libMoltenVK.dylib)
  string(JSON _expected GET "${_pin}" public_runtime_dependencies "${_dependency}")
  file(SHA256 "${BLUR_PUBLIC_SDK_PREFIX}/lib/${_dependency}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Public SDK runtime dependency hash mismatch: ${_dependency}")
  endif()
endforeach()
target_sources(rexgpu-xenos PRIVATE "${_blur_root}/recomp/metal/fixtures/translate.cpp")
# The source SDK keeps ImGui private, but its application headers/host sources
# use ImGui directly. Match the SDK's in-tree application linkage.
target_link_libraries(blur_x360 PRIVATE imgui)
target_compile_definitions(blur_x360 PRIVATE BLURCOMPILED_NATIVE_METAL=1)
if(BLUR_METAL_PREPARE_FIXTURES)
  message(STATUS "Metal fixture preparation only; reconfigure with BLUR_METAL_PREPARE_FIXTURES=OFF after extraction")
  return()
endif()
if(NOT EXISTS "${BLUR_PLUME_FIXTURE_DIR}/rex_plume_embedded_shaders.hpp")
  message(FATAL_ERROR "Generate your local shader fixtures first; see docs/BUILD_GAME.md")
endif()
set(BLUR_PLUME_RENDERER ON CACHE BOOL "" FORCE)
set(BLUR_PLUME_GUEST_ADAPTER ON CACHE BOOL "" FORCE)
set(BLUR_REX_PLUME_FRONTEND ON CACHE BOOL "" FORCE)
set(BLUR_REX_SDK_SOURCE_DIR "${REXSDK_DIR}" CACHE PATH "" FORCE)
add_subdirectory("${_blur_root}" blurcompiled-support)
find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(_original "${REXSDK_DIR}/src/graphics/metal_runtime/metal_command_processor.cpp")
set(_instrumented "${CMAKE_CURRENT_BINARY_DIR}/plume-hooks/metal_command_processor.cpp")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${_blur_root}/tools/instrument_metal.py"
  "${_original}" "${_instrumented}" COMMAND_ERROR_IS_FATAL ANY)
get_target_property(_sources rexgpu-xenos SOURCES)
list(FILTER _sources EXCLUDE REGEX "metal_runtime/metal_command_processor[.]cpp$")
set_property(TARGET rexgpu-xenos PROPERTY SOURCES "${_sources}")
target_sources(rexgpu-xenos PRIVATE "${_instrumented}")
target_include_directories(rexgpu-xenos PRIVATE "${BLUR_PLUME_FIXTURE_DIR}"
  "${_blur_root}/src" "${_blur_root}/recomp/native" "${REXSDK_DIR}/src/graphics/metal_runtime")
target_link_libraries(rexgpu-xenos PRIVATE blur-rex-plume-state)
add_dependencies(blur_x360 blur-plume-bridge)
add_custom_command(TARGET blur_x360 POST_BUILD
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "$<TARGET_FILE:blur-plume-bridge>" "$<TARGET_FILE_DIR:blur_x360>"
  COMMAND "${Python3_EXECUTABLE}" "${_blur_root}/tools/stage_metal_runtime.py"
    "$<TARGET_FILE_DIR:blur_x360>" "${REXGLUE_METAL_DEPS_ROOT}"
  VERBATIM)
