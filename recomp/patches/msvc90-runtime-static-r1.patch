+            if (invoke(&c, "HeapReAlloc", h1, 0, p1, 0xffffffffu) || rd32(p1) != 0x12345678 ||
+                !heap_owns(p1))
+                return 14;
+            uint32_t grown = invoke(&c, "HeapReAlloc", h1, 8, p1, 1024);
+            if (!grown || rd32(grown) != 0x12345678 || rd32(grown + 32))
+                return 15;
+            if (invoke(&c, "HeapSize", h1, 0, grown) != 1024)
+                return 16;
+            if (!invoke(&c, "HeapDestroy", h1) || heap_owns(grown) || !heap_owns(p2))
