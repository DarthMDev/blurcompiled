+        return 4;
+    for (const char *name : {"missing", "signature", "unknown", "interp", "valid", "critical",
+                             "heaps", "environment"}) {
+        const char *args[] = {exe, name, nullptr};
+        int64_t pid = 0;
+        int code = -1;
+        if (os_spawn(args, &pid) || os_wait(pid, &code) ||
+            code != ((!strcmp(name, "valid") || !strcmp(name, "critical") ||
+                      !strcmp(name, "heaps") || !strcmp(name, "environment"))
+                         ? 0
+                         : 134)) {
+            fprintf(stderr, "strict guard %s failed, exit=%d\n", name, code);
+            return 1;
+        }
+    }
+    puts("crt_strict_tests: 8 subprocess cases passed");
+    return 0;
+}
