+            if (invoke(&c, "HeapAlloc", h1, 0, 32) || invoke(&c, "HeapDestroy", h1))
+                return 18;
+            if (!invoke(&c, "HeapFree", h2, 0, p2) || !invoke(&c, "HeapDestroy", h2))
