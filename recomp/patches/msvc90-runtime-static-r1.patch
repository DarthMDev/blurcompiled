+// Synthetic PE import/export storage and translated entry callbacks only.
+#include "../imports.h"
+#include "../loader.h"
+#include "../memory.h"
+#include "../win32.h"
+#include "../../platform/os.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+static int failures;
+#define CHECK(x) do { if (!(x)) { fprintf(stderr,"line %d: %s\n",__LINE__,#x); ++failures; } } while (0)
+static std::vector<uint32_t> events, reserved_values;
+static uint32_t fail_base;
+static void entry(X86 *c) {
+    uint32_t base = arg(c,0), reason = arg(c,1);
+    events.push_back(base | reason);
+    reserved_values.push_back(arg(c,2));
+    c->r[R_EAX] = reason == 1 && base == fail_base ? 0 : 1;
+    c->eip = rd32(c->r[R_ESP]);
+    c->r[R_ESP] += 16;
+    recomp_return(c);
+}
+static uint32_t invoke(X86 *c, const char *name, uint32_t arg0) {
+    uint32_t esp=c->r[R_ESP];
+    wr32(esp-8,GUEST_RETURN_SENTINEL); wr32(esp-4,arg0);
+    c->r[R_ESP]=esp-8;
+    CHECK(imports_dispatch(c,imports_resolve("KERNEL32.dll",name)));
+    CHECK(c->r[R_ESP]==esp);
+    return c->r[R_EAX];
+}
+static LoaderModule make(const char *name,uint32_t base) {
+    LoaderModule m; m.name=name; m.base=base; m.size=0x1000; m.entry=base+0x800;
+    m.export_rva=0x100;m.export_size=0x100;
+    memset(g_mem+base,0,m.size);
+    wr32(base+0x110,7);wr32(base+0x114,2);wr32(base+0x118,2);
+    wr32(base+0x11c,0x200);wr32(base+0x120,0x220);wr32(base+0x124,0x230);
+    wr32(base+0x200,0x800);wr32(base+0x204,0x900);
+    wr32(base+0x220,0x300);wr32(base+0x224,0x310);
+    wr16(base+0x230,0);wr16(base+0x232,1);
+    gm_put_str(base+0x300,"Code",16);gm_put_str(base+0x310,"Data",16);
+    m.initial_image.assign(g_mem+base,g_mem+base+m.size);return m;
+}
+int main() {
+    os_setenv("RECOMP_STRICT_EXECUTION","1");
+    mem_init(); imports_init(); win32_init(".");
+    constexpr uint32_t a=0x01000000,b=0x01100000,d=0x01200000;
+    static const uint32_t addresses[]={a+0x800,b+0x800,d+0x800};
+    static void (*const functions[])(X86*)={entry,entry,entry};
+    static RecompHookFn hooks[3]{};static uint8_t hooked[3]{};
+    static const RecompModule translated={"synthetic-dlls",a,d+0x1000,addresses,3,functions,hooks,hooked,nullptr,0,nullptr};
+    recomp_module_register(&translated);
+    LoaderModule main=make(RECOMP_EXECUTABLE,0x00400000);main.attached=true;
+    LoaderModule ma=make("A.dll",a),mb=make("B.dll",b),md=make("D.dll",d);
+    ma.dependencies={"B.dll","D.dll"};md.dependencies={"B.dll"};main.dependencies={"A.dll"};
+    loader_test_modules(main,{ma,md,mb}); // deliberately reverse dependency order
+    X86 c;loader_init_context(&c);uint32_t esp=c.r[R_ESP];
+    std::vector<uint32_t> order;
+    CHECK(loader_dependency_order(*loader_module_named(RECOMP_EXECUTABLE),order));
+    CHECK((order==std::vector<uint32_t>{b,d,a}));
+    CHECK(win32_attach_static_modules(&c));
+    CHECK((events==std::vector<uint32_t>{b|1,d|1,a|1}));
+    CHECK(loader_module_named("B.dll")->load_refs==2);
+    CHECK(win32_attach_static_modules(&c) && events.size()==3 &&
+          loader_module_named("B.dll")->load_refs==2);
+    CHECK(c.r[R_ESP]==esp);
+    for(auto value:reserved_values)CHECK(value!=0 && value<GUEST_SIZE);
+    gm_put_str(0x00300000,"A.dll",16);
+    CHECK(invoke(&c,"LoadLibraryA",0x00300000)==a);
+    CHECK(events.size()==3 && loader_module_named("A.dll")->load_refs==2);
+    CHECK(invoke(&c,"FreeLibrary",a)==1 && events.size()==3);
+    win32_detach_process_modules(&c);
+    CHECK((events==std::vector<uint32_t>{b|1,d|1,a|1,a,d,b}));
+    for(auto value:reserved_values)CHECK(value!=0);
+    win32_detach_process_modules(&c);CHECK(events.size()==6);
+    CHECK(!loader_module_named("B.dll")->load_refs);
+    // Dynamic dependency acquisition and reverse release use NULL reserved.
+    events.clear();reserved_values.clear();
+    CHECK(invoke(&c,"LoadLibraryA",0x00300000)==a);
+    CHECK(invoke(&c,"FreeLibrary",a)==1);
+    CHECK((events==std::vector<uint32_t>{b|1,d|1,a|1,a,d,b}));
+    for(auto value:reserved_values)CHECK(value==0);
+    // A failing top-level entry unwinds the shared dependency closure once.
+    events.clear();reserved_values.clear();fail_base=a;
+    CHECK(invoke(&c,"LoadLibraryA",0x00300000)==0);
+    CHECK((events==std::vector<uint32_t>{b|1,d|1,a|1,a,d,b}));
+    CHECK(!loader_module_named("B.dll")->load_refs && !loader_module_named("A.dll")->attached);
+    // Failure of a nested dependency unwinds earlier acquisitions.
+    events.clear();reserved_values.clear();fail_base=d;
+    loader_test_modules(main,{ma,md,mb});
+    CHECK(!win32_attach_static_modules(&c));
+    CHECK((events==std::vector<uint32_t>{b|1,d|1,d,b}));
+    CHECK(!loader_module_named("B.dll")->attached);
+    // Roll back an earlier successful EXE root if a later root fails.
+    events.clear();reserved_values.clear();fail_base=a;
+    LoaderModule two_roots=main;two_roots.dependencies={"B.dll","A.dll"};
+    loader_test_modules(two_roots,{ma,md,mb});
+    CHECK(!win32_attach_static_modules(&c));
+    CHECK((events==std::vector<uint32_t>{b|1,d|1,a|1,a,d,b}));
+    CHECK(!loader_module_named("B.dll")->load_refs);
+    // A failed load must retain another caller's preexisting B reference.
+    loader_test_modules(main,{ma,md,mb});events.clear();fail_base=0;
+    gm_put_str(0x00300000,"B.dll",16);CHECK(invoke(&c,"LoadLibraryA",0x00300000)==b);
+    events.clear();fail_base=a;gm_put_str(0x00300000,"A.dll",16);
+    CHECK(invoke(&c,"LoadLibraryA",0x00300000)==0);
+    CHECK((events==std::vector<uint32_t>{d|1,a|1,a,d}));
+    CHECK(loader_module_named("B.dll")->load_refs==1 && loader_module_named("B.dll")->attached);
+    CHECK(invoke(&c,"FreeLibrary",b)==1);
+    fail_base=0;events.clear();
+    loader_module_named("B.dll")->dependencies={"A.dll"};
+    CHECK(!win32_attach_static_modules(&c) && events.empty());
+    CHECK(strstr(loader_error(),"cyclic")!=nullptr);
+    loader_module_named("B.dll")->dependencies={"MISSING.dll"};
+    CHECK(!loader_dependency_order(*loader_module_named("A.dll"),order));
+    // Bind code by name and data by ordinal into a caller after all modules
+    // have been published. No shim/trampoline or copied data is acceptable.
+    main.dependencies.clear();loader_test_modules(main,{ma,md,mb});
+    std::vector<uint8_t> file(128);uint32_t imp=0x400,impsize=40;
+    memcpy(file.data()+104,&imp,4);memcpy(file.data()+108,&impsize,4);
+    uint32_t base=main.base;memset(g_mem+base+0x400,0,0x300);
+    wr32(base+0x400,0x500);wr32(base+0x40c,0x480);wr32(base+0x410,0x540);
+    gm_put_str(base+0x480,"B.dll",16);wr32(base+0x500,0x580);wr32(base+0x504,0x80000008);
+    gm_put_str(base+0x582,"Code",16);
+    CHECK(loader_test_bind(file,base,main.size));
+    CHECK(rd32(base+0x540)==b+0x800 && rd32(base+0x544)==b+0x900);
+    wr32(rd32(base+0x544),0x12345678);CHECK(rd32(b+0x900)==0x12345678);
+    CHECK(loader_module_named(RECOMP_EXECUTABLE)->dependencies==std::vector<std::string>{"B.dll"});
+    gm_put_str(base+0x582,"NoSuchExport",32);
+    CHECK(!loader_test_bind(file,base,main.size));
+    CHECK(strstr(loader_error(),"missing mapped export")!=nullptr);
+    // A missing terminator in the declared descriptor directory is rejected.
+    uint32_t short_size=20;memcpy(file.data()+108,&short_size,4);
+    gm_put_str(base+0x582,"Code",16);
+    CHECK(!loader_test_bind(file,base,main.size));
+    CHECK(strstr(loader_error(),"unterminated import descriptor")!=nullptr);
+    memcpy(file.data()+108,&impsize,4);
+    wr32(base+0x40c,main.size-2);memset(g_mem+base+main.size-2,'x',2);
+    CHECK(!loader_test_bind(file,base,main.size));
+    CHECK(strstr(loader_error(),"unterminated")!=nullptr);
+    // Entry-less DLLs need no fabricated translated entry to be loadable.
+    auto *empty=loader_module_named("B.dll");empty->entry=0;empty->dependencies.clear();
+    gm_put_str(0x00300000,"B.dll",16);CHECK(invoke(&c,"LoadLibraryA",0x00300000)==b);
+    CHECK(invoke(&c,"FreeLibrary",b)==1);
+    printf("dll_binding_tests: %d failures\n",failures);return failures?1:0;
+}
