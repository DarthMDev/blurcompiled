+// Synthetic guards: no PE or original DLL is needed.
+#include "../imports.h"
+#include "../interp.h"
+#include "../loader.h"
+#include "../memory.h"
+#include "../win32.h"
+#include "../../platform/os.h"
+#include <cstdio>
+#include <cstring>
+
+static uint32_t invoke(X86 *c, const char *name, uint32_t a, uint32_t b = 0, uint32_t d = 0,
+                       uint32_t e = 0) {
+    c->r[R_ESP] = 0x0efff000;
+    wr32(c->r[R_ESP], GUEST_RETURN_SENTINEL);
+    wr32(c->r[R_ESP] + 4, a);
+    wr32(c->r[R_ESP] + 8, b);
+    wr32(c->r[R_ESP] + 12, d);
+    wr32(c->r[R_ESP] + 16, e);
+    uint32_t t = imports_resolve("KERNEL32.dll", name);
+    if (!t || !imports_dispatch(c, t))
+        return 0xffffffffu;
+    return c->r[R_EAX];
+}
+static void answer(X86 *c) {
+    c->r[R_EAX] = 42;
+}
+int main(int argc, char **argv) {
+    os_setenv("RECOMP_STRICT_EXECUTION", "1");
+    if (argc > 1) {
+        mem_init();
+        imports_init();
+        win32_init(".");
+        X86 c{};
+        loader_init_context(&c);
+        if (!strcmp(argv[1], "missing"))
+            imports_dispatch(&c, imports_alloc_trampoline("SYNTH.dll", "missing", nullptr, 0));
+        if (!strcmp(argv[1], "signature"))
+            imports_dispatch(
+                &c, imports_alloc_trampoline("SYNTH.dll", "signature", answer, ARGC_UNKNOWN));
+        if (!strcmp(argv[1], "unknown"))
+            recomp_unknown_call(&c, 0x00401000);
+        if (!strcmp(argv[1], "interp"))
+            interp_call(&c, 0x00401000);
+        if (!strcmp(argv[1], "critical")) {
+            uint32_t at = 0x02001000;
+            wr32(at - 4, 0x12345678);
+            wr32(at + 24, 0x87654321);
+            if (invoke(&c, "InitializeCriticalSectionAndSpinCount", at, 4000) != 1 ||
+                c.r[R_ESP] != 0x0efff00c)
+                return 5;
+            if (rd32(at + 4) != 0xffffffffu || rd32(at + 8) || rd32(at + 12) || rd32(at + 20))
+                return 6;
+            invoke(&c, "EnterCriticalSection", at);
+            invoke(&c, "EnterCriticalSection", at);
+            if (rd32(at + 8) != 2 || !rd32(at + 12))
+                return 7;
+            invoke(&c, "LeaveCriticalSection", at);
+            invoke(&c, "LeaveCriticalSection", at);
+            if (rd32(at + 8) || rd32(at + 12))
+                return 8;
+            invoke(&c, "DeleteCriticalSection", at);
+            if (rd32(at - 4) != 0x12345678 || rd32(at + 24) != 0x87654321)
+                return 9;
+            mem_shutdown();
+            return 0;
+        }
+        if (!strcmp(argv[1], "heaps")) {
+            HeapStats baseline = heap_stats();
+            uint32_t h1 = invoke(&c, "HeapCreate", 0, 4096, 0),
+                     h2 = invoke(&c, "HeapCreate", 0, 4096, 0);
+            if (!h1 || !h2 || h1 == h2)
+                return 10;
+            uint32_t p1 = invoke(&c, "HeapAlloc", h1, 8, 32),
+                     p2 = invoke(&c, "HeapAlloc", h2, 0, 64);
