+def noreturn_iat_operand(image, operand):
+    """Only a literal PE-verified Kernel32 exit IAT slot proves this call terminal.
+
+    Register calls, indexed memory and unrelated DLLs with the same export name
+    remain ordinary calls. A returning/rebound exit import fails explicitly in
+    emitted code instead of continuing through the bytes after the call.
+    """
+    match = re.fullmatch(r"dword ptr \[(0x[0-9a-fA-F]+)\]", operand.strip())
+    return bool(match and int(match.group(1), 16) in getattr(image, "noreturn_iat_slots", ()))
+
