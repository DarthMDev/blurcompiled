+def test_only_kernel32_exit_imports_are_terminal(tmp_path):
+    for name, dll, terminal in ((b"ExitProcess", b"KERNEL32.dll", True),
+                                (b"ExitThread", b"KERNEL32.dll", True),
+                                (b"TerminateProcess", b"KERNEL32.dll", False),
+                                (b"RaiseException", b"KERNEL32.dll", False),
+                                (b"ExitProcess", b"SOMELIBX.dll", False)):
+        path = tmp_path / "exit.exe"
+        minimal_pe(path)
+        data = bytearray(path.read_bytes())
+        data[0x460:0x480] = (b"\0\0" + name + b"\0").ljust(32, b"\0")
+        data[0x480:0x48d] = dll + b"\0"
+        data[0x200:0x207] = b"\xff\x15" + struct.pack("<I", IAT_SLOT) + b"\xcc"
+        path.write_bytes(data)
+        image = T.Image(str(path))
+        assert (IAT_SLOT in image.noreturn_iat_slots) is terminal
+        if terminal:
+            insns = image.recover(CALLER, set())
+            assert len(insns) == 1 and insns[0].mnem == "CALL"
+
+
+
+def test_recovered_simd_memory_width_uses_existing_listing_grammar(tmp_path):
+    path = tmp_path / "simd.exe"
+    minimal_pe(path)
+    data = bytearray(path.read_bytes())
+    # MOVAPD XMM1,[absolute]; RET. The decoder must not lose a real export
+    # because its memory operand is 16 bytes rather than a scalar width.
+    code = b"\x66\x0f\x28\x0d" + struct.pack("<I", BASE + IDATA) + b"\xc3"
+    data[0x200:0x200 + len(code)] = code
+    path.write_bytes(data)
+    image = T.Image(str(path))
+    recovered = image.recover(CALLER, set())
+    assert [i.mnem for i in recovered] == ["MOVAPD", "RET"]
+    operand = T.parse_operand(recovered[0].ops[1])
+    assert operand.kind == "mem" and operand.size == 128
