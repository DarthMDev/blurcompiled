+                                (b"ExitThread", b"KERNEL32.dll", True),
+                                (b"TerminateProcess", b"KERNEL32.dll", False),
+                                (b"RaiseException", b"KERNEL32.dll", False),
+                                (b"ExitProcess", b"SOMELIBX.dll", False)):
