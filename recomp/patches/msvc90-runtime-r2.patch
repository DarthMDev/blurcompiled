+
+def iat_translation(listing, entries=(), terminal=True):
+    image = NoImage()
+    image.noreturn_iat_slots = {IAT} if terminal else set()
+    image.insn_end = lambda addr, mnem: addr + 6 if mnem == "CALL" else None
+    tr = T.Translator(image, {FN}, Opts())
+    fn = T.Function(FN, "exit_test", 0x40, T.parse_listing_text(listing))
+    fn.measure(image)
+    tr.prepare(fn)
+    return tr, fn, "\n".join(tr.translate(fn, entries))
+
+
+def test_exit_iat_ends_body_and_fails_if_import_returns():
+    tr, fn, text = iat_translation("00401100  CALL dword ptr [0x402040]\n")
+    assert tr.successors(fn, 0) == []
+    assert "recomp_call(c, t_);" in text
+    assert "recomp_unknown_call(c, 0x401106u); return;" in text
+    assert "recomp_jump" not in text
+    assert tr.stats["_fallthrough_exit"] == 0
+
+
+def test_exit_iat_does_not_delete_independent_branch_or_entry():
+    listing = ("00401100  TEST EAX,EAX\n00401102  JZ 0x401110\n"
+               "00401104  CALL dword ptr [0x402040]\n"
+               "0040110a  MOV EAX,0xbad\n"
+               "00401110  MOV EAX,0x123\n00401115  RET\n")
+    _, _, text = iat_translation(listing)
+    assert "0xbadu" not in text
+    assert "0x123u" in text
+    _, _, text = iat_translation(listing, entries=(0x40110a,))
+    assert "0xbadu" in text
+
+
+def test_ordinary_and_computed_import_calls_still_return():
+    for operand in ("dword ptr [0x402044]", "dword ptr [EAX]", "EAX"):
+        tr, fn, text = iat_translation("00401100  CALL %s\n00401106  RET\n" % operand)
+        assert tr.successors(fn, 0) == [1]
