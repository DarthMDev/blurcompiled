+bool loader_dependency_order(const LoaderModule &root, std::vector<uint32_t> &order) {
+    order.clear();
+    std::map<uint32_t, unsigned> marks;
+    std::function<bool(const LoaderModule &)> visit = [&](const LoaderModule &m) {
+        if (marks[m.base] == 1) {
+            g_error = "unsupported cyclic DLL dependency at " + m.name;
+            return false;
+        }
+        if (marks[m.base] == 2)
+            return true;
+        marks[m.base] = 1;
+        for (const auto &name : m.dependencies) {
+            const LoaderModule *dep = loader_module_named(name.c_str());
+            if (!dep) {
+                g_error = "missing mapped dependency " + name;
+                return false;
+            }
+            if (!visit(*dep))
+                return false;
+        }
+        marks[m.base] = 2;
+        if (m.base != loader_image_base())
+            order.push_back(m.base);
+        return true;
+    };
+    return visit(root);
+}
