+// Synthetic PE import/export storage and translated entry callbacks only.
+#include "../imports.h"
+#include "../loader.h"
+#include "../memory.h"
+#include "../win32.h"
+#include "../../platform/os.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+static int failures;
+#define CHECK(x) do { if (!(x)) { fprintf(stderr,"line %d: %s\n",__LINE__,#x); ++failures; } } while (0)
+static std::vector<uint32_t> events, reserved_values;
+static uint32_t fail_base;
+static void entry(X86 *c) {
+    uint32_t base = arg(c,0), reason = arg(c,1);
+    events.push_back(base | reason);
+    reserved_values.push_back(arg(c,2));
+    c->r[R_EAX] = reason == 1 && base == fail_base ? 0 : 1;
+    c->eip = rd32(c->r[R_ESP]);
+    c->r[R_ESP] += 16;
+    recomp_return(c);
+}
+static uint32_t invoke(X86 *c, const char *name, uint32_t arg0) {
+    uint32_t esp=c->r[R_ESP];
+    wr32(esp-8,GUEST_RETURN_SENTINEL); wr32(esp-4,arg0);
+    c->r[R_ESP]=esp-8;
+    CHECK(imports_dispatch(c,imports_resolve("KERNEL32.dll",name)));
+    CHECK(c->r[R_ESP]==esp);
+    return c->r[R_EAX];
+}
+static LoaderModule make(const char *name,uint32_t base) {
+    LoaderModule m; m.name=name; m.base=base; m.size=0x1000; m.entry=base+0x800;
+    m.export_rva=0x100;m.export_size=0x100;
+    memset(g_mem+base,0,m.size);
+    wr32(base+0x110,7);wr32(base+0x114,2);wr32(base+0x118,2);
+    wr32(base+0x11c,0x200);wr32(base+0x120,0x220);wr32(base+0x124,0x230);
