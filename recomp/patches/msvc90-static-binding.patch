+bool win32_attach_static_modules(X86 *c) {
+    if (g_static_initialized)
+        return true;
+    LoaderModule *main = loader_module_named(RECOMP_EXECUTABLE);
+    if (!main)
+        return true;
+    std::vector<uint32_t> order;
+    if (!loader_dependency_order(*main, order))
+        return false;
+    std::vector<uint32_t> acquired;
+    // A nonnull guest startup marker satisfies the opaque reserved contract.
+    // Do not pass an address from the host's native stack.
+    for (const auto &name : main->dependencies) {
+        LoaderModule *m = loader_module_named(name.c_str());
+        if (!acquire_guest_module(c, *m, TEB_BASE - 0x1000)) {
+            for (auto i = acquired.rbegin(); i != acquired.rend(); ++i)
+                release_guest_module(c, *loader_module_named(loader_module_containing(*i)->name.c_str()));
+            return false;
+        }
+        acquired.push_back(m->base);
+    }
+    g_static_initialized = true;
+    return true;
+}
+
+void win32_detach_process_modules(X86 *c) {
+    // Entries may invoke ExitProcess. Remove each module before entering it,
+    // preventing a second termination pass from detaching it twice.
+    while (!g_module_attach_order.empty()) {
+        uint32_t base = g_module_attach_order.back();
+        g_module_attach_order.pop_back();
+        auto *m = loader_module_named(loader_module_containing(base)->name.c_str());
+        if (!m->attached)
+            continue;
+        m->initializing = true;
+        m->load_refs = 0;
+        m->acquired_dependencies.clear();
+        call_dll_entry(c, *m, 0, TEB_BASE - 0x1000);
+        m->attached = false;
+        m->initializing = false;
+    }
+    g_static_initialized = false;
+}
