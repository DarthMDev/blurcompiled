+struct ConstantTableState {
+    uint32_t ctab_base = 0;
+    uint32_t constants_count = 0;
+    uint32_t creator = 0;
+    uint32_t version = 0;
+    uint32_t info = 0;
+};
+static std::map<uint32_t, ConstantTableState> g_constant_tables;
+
+static bool find_ctab(uint32_t pFunction, ConstantTableState &st) {
+    if (!pFunction || !gm_fits(pFunction, 64))
+        return false;
+    for (uint32_t off = 0; off < 65536 && gm_fits(pFunction + off, 36); off += 4) {
+        if (rd32(pFunction + off) == 0x42415443) { // 'CTAB'
+            uint32_t ctab_base = pFunction + off + 4;
+            st.ctab_base = ctab_base;
+            uint32_t creator_off = rd32(ctab_base + 4);
+            st.version = rd32(ctab_base + 8);
+            st.constants_count = rd32(ctab_base + 12);
+            uint32_t info_off = rd32(ctab_base + 16);
+            st.creator = creator_off ? ctab_base + creator_off : 0;
+            st.info = info_off ? ctab_base + info_off : 0;
+            return true;
+        }
+    }
+    return false;
+}
