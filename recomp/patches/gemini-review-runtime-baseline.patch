+/* CMPXCHG8B helper that yields the cooperative baton when contested */
+static inline void recomp_cmpxchg8b(X86 *c, uint32_t addr) {
+    uint64_t dst_ = rd64(addr);
+    uint64_t expected_ = ((uint64_t)c->r[2] << 32) | c->r[0];
+    c->eflags_zf = (expected_ == dst_);
+    if (c->eflags_zf) {
+        wr64(addr, ((uint64_t)c->r[1] << 32) | c->r[3]);
+    } else {
+        c->r[0] = (uint32_t)dst_;
+        c->r[2] = (uint32_t)(dst_ >> 32);
+        host_guest_yield();
+    }
