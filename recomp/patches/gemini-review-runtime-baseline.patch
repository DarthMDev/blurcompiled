+    float up[3] = {rf(pUp), rf(pUp + 4), rf(pUp + 8)};
+    float z[3] = {at[0] - eye[0], at[1] - eye[1], at[2] - eye[2]};
+    float len_z = sqrtf(z[0]*z[0] + z[1]*z[1] + z[2]*z[2]);
+    if (len_z > 0) { z[0] /= len_z; z[1] /= len_z; z[2] /= len_z; }
+    float x[3] = {up[1]*z[2] - up[2]*z[1], up[2]*z[0] - up[0]*z[2], up[0]*z[1] - up[1]*z[0]};
+    float len_x = sqrtf(x[0]*x[0] + x[1]*x[1] + x[2]*x[2]);
+    if (len_x > 0) { x[0] /= len_x; x[1] /= len_x; x[2] /= len_x; }
+    float y[3] = {z[1]*x[2] - z[2]*x[1], z[2]*x[0] - z[0]*x[2], z[0]*x[1] - z[1]*x[0]};
+    float m[16] = {
+        x[0], y[0], z[0], 0.0f,
+        x[1], y[1], z[1], 0.0f,
+        x[2], y[2], z[2], 0.0f,
+        -(x[0]*eye[0] + x[1]*eye[1] + x[2]*eye[2]),
+        -(y[0]*eye[0] + y[1]*eye[1] + y[2]*eye[2]),
+        -(z[0]*eye[0] + z[1]*eye[1] + z[2]*eye[2]),
+        1.0f
+    };
+    write_matrix(out, m);
+    set_eax(c, out);
+}
+
+void X_D3DXPlaneNormalize(X86 *c) {
+    uint32_t out = arg(c, 0), in = arg(c, 1);
+    float a = rf(in), b = rf(in+4), d = rf(in+8), e = rf(in+12);
+    float len = sqrtf(a*a + b*b + d*d);
+    if (len > 0) { a /= len; b /= len; d /= len; e /= len; }
+    wf(out, a); wf(out+4, b); wf(out+8, d); wf(out+12, e);
+    set_eax(c, out);
+}
