+void X_D3DXGetShaderConstantTable(X86 *c) {
+    uint32_t pFunction = arg(c, 0);
+    uint32_t out = arg(c, 1);
+    if (!out) {
+        set_eax(c, D3DERR_INVALIDCALL);
+        return;
+    }
+    ComObj *ct = com_new(K_D3DXCONSTANTTABLE);
+    if (!ct) {
+        set_eax(c, E_OUTOFMEMORY);
+        return;
+    }
+    ConstantTableState st;
+    if (find_ctab(pFunction, st)) {
+        g_constant_tables[ct->id] = st;
+        LOGW("d3dx9: D3DXGetShaderConstantTable found CTAB with %u constants", st.constants_count);
+    } else {
+        g_constant_tables[ct->id] = ConstantTableState{};
+        LOGW("d3dx9: D3DXGetShaderConstantTable no CTAB found (0 constants)");
+    }
+    uint32_t view_ = com_view(ct, IF_D3DXCONSTANTTABLE);
+    if (!view_) {
+        com_release(ct);
+        set_eax(c, E_OUTOFMEMORY);
+        return;
+    }
+    com_out_ptr(out, view_);
+    set_eax(c, D3D_OK9);
