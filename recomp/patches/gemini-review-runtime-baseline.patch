+    std::string profile = (pProfile && gm_valid(pProfile, 1)) ? gm_str(pProfile, 32) : "";
+    LOGV("d3dx9: D3DXCompileShader(profile=%s, len=%u)", profile.c_str(), srcLen);
+
+    bool is_vs = (!profile.empty() && profile[0] == 'v');
+    // Valid minimal D3D9 shader bytecode:
+    // Header token: 0xFFFF0300 (ps_3_0) or 0xFFFE0300 (vs_3_0)
+    // End token: 0x0000FFFF (D3DSIO_END)
+    static const uint32_t s_dummy_ps30[] = {0xFFFF0300u, 0x0000FFFFu};
+    static const uint32_t s_dummy_vs30[] = {0xFFFE0300u, 0x0000FFFFu};
+    const uint32_t *bytecode = is_vs ? s_dummy_vs30 : s_dummy_ps30;
+    uint32_t bytecode_bytes = sizeof(s_dummy_ps30);
+
+    ComObj *b = com_new(K_D3DXBUFFER);
+    if (!b) {
+        set_eax(c, E_OUTOFMEMORY);
+        return;
+    }
+    b->buf_bytes = bytecode_bytes;
+    b->buf_pixels = heap_alloc(bytecode_bytes, true, 16);
+    if (!b->buf_pixels) {
+        com_release(b);
+        set_eax(c, E_OUTOFMEMORY);
