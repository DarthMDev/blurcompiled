+void BinkGetFrameBuffersInfo(X86 *c) {
+    uint32_t bnk = arg(c, 0);
+    uint32_t fb = arg(c, 1);
+    if (fb && gm_valid(fb, 24)) {
+        uint32_t w = (bnk && gm_valid(bnk, 8)) ? rd32(bnk) : 640;
+        uint32_t h = (bnk && gm_valid(bnk, 8)) ? rd32(bnk + 4) : 480;
+        wr32(fb + 0, 2); // TotalFrames = 2 (double buffering ring)
+        wr32(fb + 4, w); // YABufferWidth
+        wr32(fb + 8, h); // YABufferHeight
+        wr32(fb + 12, (w + 1) / 2); // cBufferWidth
+        wr32(fb + 16, (h + 1) / 2); // cBufferHeight
+        wr32(fb + 20, 0); // FrameNum
+        // BINKFRAMEPLANES Frames[2]: each frame has Y, cR, cB, and A planes.
+        // Each plane has: u32 Allocate, void* Buffer, u32 BufferPitch (12 bytes).
+        // 4 planes * 12 bytes = 48 bytes per frame.
+        if (gm_valid(fb + 24, 2 * 48)) {
+            for (uint32_t frame = 0; frame < 2; ++frame) {
+                uint32_t base = fb + 24 + frame * 48;
+                wr32(base + 0, 1);  // Frames[frame].YPlane.Allocate = 1
+                wr32(base + 4, 0);  // YPlane.Buffer
+                wr32(base + 8, 0);  // YPlane.BufferPitch
+                wr32(base + 12, 1); // Frames[frame].cRPlane.Allocate = 1
+                wr32(base + 16, 0); // cRPlane.Buffer
+                wr32(base + 20, 0); // cRPlane.BufferPitch
+                wr32(base + 24, 1); // Frames[frame].cBPlane.Allocate = 1
+                wr32(base + 28, 0); // cBPlane.Buffer
+                wr32(base + 32, 0); // cBPlane.BufferPitch
+                wr32(base + 36, 0); // Frames[frame].APlane.Allocate = 0
+                wr32(base + 40, 0); // APlane.Buffer
+                wr32(base + 44, 0); // APlane.BufferPitch
+            }
+        }
+    }
+    set_eax(c, 0);
+}
+
+void BinkRegisterFrameBuffers(X86 *c) {
+    set_eax(c, 0);
+}
+
+void BinkSetSoundTrack(X86 *c) {
+    set_eax(c, 0);
+}
