+    auto it = g_constant_tables.find(ct->id);
+    if (it == g_constant_tables.end()) {
+        set_eax(c, (uint32_t)-1);
+        return;
+    }
+    uint32_t index = hConstant - 1;
+    if (index >= it->second.constants_count) {
+        set_eax(c, (uint32_t)-1);
+        return;
+    }
+    uint32_t entry = it->second.info + index * 20u;
+    uint16_t reg_set = rd16(entry + 4);
+    uint16_t reg_idx = rd16(entry + 6);
+    set_eax(c, reg_set == 3 ? (uint32_t)reg_idx : (uint32_t)-1);
