diff --git a/runtime/tests/crt_strict_tests.cpp b/runtime/tests/crt_strict_tests.cpp
new file mode 100644
index 0000000..0ca2d2e
--- /dev/null
+++ b/runtime/tests/crt_strict_tests.cpp
@@ -0,0 +1,156 @@
+// Synthetic guards: no PE or original DLL is needed.
+#include "../imports.h"
+#include "../interp.h"
+#include "../loader.h"
+#include "../memory.h"
+#include "../win32.h"
+#include "../../platform/os.h"
+#include <cstdio>
+#include <cstring>
+
+static uint32_t invoke(X86 *c, const char *name, uint32_t a, uint32_t b = 0, uint32_t d = 0,
+                       uint32_t e = 0) {
+    c->r[R_ESP] = 0x0efff000;
+    wr32(c->r[R_ESP], GUEST_RETURN_SENTINEL);
+    wr32(c->r[R_ESP] + 4, a);
+    wr32(c->r[R_ESP] + 8, b);
+    wr32(c->r[R_ESP] + 12, d);
+    wr32(c->r[R_ESP] + 16, e);
+    uint32_t t = imports_resolve("KERNEL32.dll", name);
+    if (!t || !imports_dispatch(c, t))
+        return 0xffffffffu;
+    return c->r[R_EAX];
+}
+static void answer(X86 *c) {
+    c->r[R_EAX] = 42;
+}
+int main(int argc, char **argv) {
+    os_setenv("RECOMP_STRICT_EXECUTION", "1");
+    if (argc > 1) {
+        mem_init();
+        imports_init();
+        win32_init(".");
+        X86 c{};
+        loader_init_context(&c);
+        if (!strcmp(argv[1], "missing"))
+            imports_dispatch(&c, imports_alloc_trampoline("SYNTH.dll", "missing", nullptr, 0));
+        if (!strcmp(argv[1], "signature"))
+            imports_dispatch(
+                &c, imports_alloc_trampoline("SYNTH.dll", "signature", answer, ARGC_UNKNOWN));
+        if (!strcmp(argv[1], "unknown"))
+            recomp_unknown_call(&c, 0x00401000);
+        if (!strcmp(argv[1], "interp"))
+            interp_call(&c, 0x00401000);
+        if (!strcmp(argv[1], "critical")) {
+            uint32_t at = 0x02001000;
+            wr32(at - 4, 0x12345678);
+            wr32(at + 24, 0x87654321);
+            if (invoke(&c, "InitializeCriticalSectionAndSpinCount", at, 4000) != 1 ||
+                c.r[R_ESP] != 0x0efff00c)
+                return 5;
+            if (rd32(at + 4) != 0xffffffffu || rd32(at + 8) || rd32(at + 12) || rd32(at + 20))
+                return 6;
+            invoke(&c, "EnterCriticalSection", at);
+            invoke(&c, "EnterCriticalSection", at);
+            if (rd32(at + 8) != 2 || !rd32(at + 12))
+                return 7;
+            invoke(&c, "LeaveCriticalSection", at);
+            invoke(&c, "LeaveCriticalSection", at);
+            if (rd32(at + 8) || rd32(at + 12))
+                return 8;
+            invoke(&c, "DeleteCriticalSection", at);
+            if (rd32(at - 4) != 0x12345678 || rd32(at + 24) != 0x87654321)
+                return 9;
+            mem_shutdown();
+            return 0;
+        }
+        if (!strcmp(argv[1], "heaps")) {
+            HeapStats baseline = heap_stats();
+            uint32_t h1 = invoke(&c, "HeapCreate", 0, 4096, 0),
+                     h2 = invoke(&c, "HeapCreate", 0, 4096, 0);
+            if (!h1 || !h2 || h1 == h2)
+                return 10;
+            uint32_t p1 = invoke(&c, "HeapAlloc", h1, 8, 32),
+                     p2 = invoke(&c, "HeapAlloc", h2, 0, 64);
+            if (!p1 || !p2 || rd32(p1))
+                return 11;
+            wr32(p1, 0x12345678);
+            if (invoke(&c, "HeapFree", h2, 0, p1) || !heap_owns(p1))
+                return 12;
+            if (invoke(&c, "HeapSize", h2, 0, p1) != 0xffffffffu)
+                return 13;
+            if (invoke(&c, "HeapReAlloc", h1, 0, p1, 0xffffffffu) || rd32(p1) != 0x12345678 ||
+                !heap_owns(p1))
+                return 14;
+            uint32_t grown = invoke(&c, "HeapReAlloc", h1, 8, p1, 1024);
+            if (!grown || rd32(grown) != 0x12345678 || rd32(grown + 32))
+                return 15;
+            if (invoke(&c, "HeapSize", h1, 0, grown) != 1024)
+                return 16;
+            if (!invoke(&c, "HeapDestroy", h1) || heap_owns(grown) || !heap_owns(p2))
+                return 17;
+            if (invoke(&c, "HeapAlloc", h1, 0, 32) || invoke(&c, "HeapDestroy", h1))
+                return 18;
+            if (!invoke(&c, "HeapFree", h2, 0, p2) || !invoke(&c, "HeapDestroy", h2))
+                return 19;
+            uint32_t process = invoke(&c, "GetProcessHeap", 0);
+            if (invoke(&c, "HeapDestroy", process))
+                return 20;
+            if (heap_stats().used_blocks != baseline.used_blocks || !heap_check().empty())
+                return 21;
+            mem_shutdown();
+            return 0;
+        }
+        if (!strcmp(argv[1], "environment")) {
+            HeapStats baseline = heap_stats();
+            uint32_t a = invoke(&c, "GetEnvironmentStringsA", 0),
+                     b = invoke(&c, "GetEnvironmentStringsA", 0),
+                     w = invoke(&c, "GetEnvironmentStringsW", 0);
+            if (!a || !b || !w || a == b || a == w || b == w)
+                return 22;
+            if (!g_mem[a] || rd16(w) != (uint16_t)g_mem[a])
+                return 23;
+            if (invoke(&c, "FreeEnvironmentStringsW", a) || !heap_owns(a))
+                return 24;
+            if (!invoke(&c, "FreeEnvironmentStringsA", a) || heap_owns(a))
+                return 25;
+            if (invoke(&c, "FreeEnvironmentStringsA", a))
+                return 26;
+            if (!invoke(&c, "FreeEnvironmentStringsA", b) ||
+                !invoke(&c, "FreeEnvironmentStringsW", w))
+                return 27;
+            if (heap_stats().used_blocks != baseline.used_blocks || !heap_check().empty())
+                return 28;
+            mem_shutdown();
+            return 0;
+        }
+        if (!strcmp(argv[1], "valid")) {
+            uint32_t before = c.r[R_ESP];
+            uint32_t t = imports_alloc_trampoline("SYNTH.dll", "valid", answer, 0);
+            if (!imports_dispatch(&c, t) || c.r[R_EAX] != 42 || c.r[R_ESP] != before + 4)
+                return 2;
+            mem_shutdown();
+            return 0;
+        }
+        return 3;
+    }
+    char exe[4096];
+    if (os_exe_path(exe, sizeof exe))
+        return 4;
+    for (const char *name : {"missing", "signature", "unknown", "interp", "valid", "critical",
+                             "heaps", "environment"}) {
+        const char *args[] = {exe, name, nullptr};
+        int64_t pid = 0;
+        int code = -1;
+        if (os_spawn(args, &pid) || os_wait(pid, &code) ||
+            code != ((!strcmp(name, "valid") || !strcmp(name, "critical") ||
+                      !strcmp(name, "heaps") || !strcmp(name, "environment"))
+                         ? 0
+                         : 134)) {
+            fprintf(stderr, "strict guard %s failed, exit=%d\n", name, code);
+            return 1;
+        }
+    }
+    puts("crt_strict_tests: 8 subprocess cases passed");
+    return 0;
+}
diff --git a/runtime/tests/dll_binding_tests.cpp b/runtime/tests/dll_binding_tests.cpp
new file mode 100644
index 0000000..70acd2a
--- /dev/null
+++ b/runtime/tests/dll_binding_tests.cpp
@@ -0,0 +1,145 @@
+// Synthetic PE import/export storage and translated entry callbacks only.
+#include "../imports.h"
+#include "../loader.h"
+#include "../memory.h"
+#include "../win32.h"
+#include "../../platform/os.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+static int failures;
+#define CHECK(x) do { if (!(x)) { fprintf(stderr,"line %d: %s\n",__LINE__,#x); ++failures; } } while (0)
+static std::vector<uint32_t> events, reserved_values;
+static uint32_t fail_base;
+static void entry(X86 *c) {
+    uint32_t base = arg(c,0), reason = arg(c,1);
+    events.push_back(base | reason);
+    reserved_values.push_back(arg(c,2));
+    c->r[R_EAX] = reason == 1 && base == fail_base ? 0 : 1;
+    c->eip = rd32(c->r[R_ESP]);
+    c->r[R_ESP] += 16;
+    recomp_return(c);
+}
+static uint32_t invoke(X86 *c, const char *name, uint32_t arg0) {
+    uint32_t esp=c->r[R_ESP];
+    wr32(esp-8,GUEST_RETURN_SENTINEL); wr32(esp-4,arg0);
+    c->r[R_ESP]=esp-8;
+    CHECK(imports_dispatch(c,imports_resolve("KERNEL32.dll",name)));
+    CHECK(c->r[R_ESP]==esp);
+    return c->r[R_EAX];
+}
+static LoaderModule make(const char *name,uint32_t base) {
+    LoaderModule m; m.name=name; m.base=base; m.size=0x1000; m.entry=base+0x800;
+    m.export_rva=0x100;m.export_size=0x100;
+    memset(g_mem+base,0,m.size);
+    wr32(base+0x110,7);wr32(base+0x114,2);wr32(base+0x118,2);
+    wr32(base+0x11c,0x200);wr32(base+0x120,0x220);wr32(base+0x124,0x230);
+    wr32(base+0x200,0x800);wr32(base+0x204,0x900);
+    wr32(base+0x220,0x300);wr32(base+0x224,0x310);
+    wr16(base+0x230,0);wr16(base+0x232,1);
+    gm_put_str(base+0x300,"Code",16);gm_put_str(base+0x310,"Data",16);
+    m.initial_image.assign(g_mem+base,g_mem+base+m.size);return m;
+}
+int main() {
+    os_setenv("RECOMP_STRICT_EXECUTION","1");
+    mem_init(); imports_init(); win32_init(".");
+    constexpr uint32_t a=0x01000000,b=0x01100000,d=0x01200000;
+    static const uint32_t addresses[]={a+0x800,b+0x800,d+0x800};
+    static void (*const functions[])(X86*)={entry,entry,entry};
+    static RecompHookFn hooks[3]{};static uint8_t hooked[3]{};
+    static const RecompModule translated={"synthetic-dlls",a,d+0x1000,addresses,3,functions,hooks,hooked,nullptr,0,nullptr};
+    recomp_module_register(&translated);
+    LoaderModule main=make(RECOMP_EXECUTABLE,0x00400000);main.attached=true;
+    LoaderModule ma=make("A.dll",a),mb=make("B.dll",b),md=make("D.dll",d);
+    ma.dependencies={"B.dll","D.dll"};md.dependencies={"B.dll"};main.dependencies={"A.dll"};
+    loader_test_modules(main,{ma,md,mb}); // deliberately reverse dependency order
+    X86 c;loader_init_context(&c);uint32_t esp=c.r[R_ESP];
+    std::vector<uint32_t> order;
+    CHECK(loader_dependency_order(*loader_module_named(RECOMP_EXECUTABLE),order));
+    CHECK((order==std::vector<uint32_t>{b,d,a}));
+    CHECK(win32_attach_static_modules(&c));
+    CHECK((events==std::vector<uint32_t>{b|1,d|1,a|1}));
+    CHECK(loader_module_named("B.dll")->load_refs==2);
+    CHECK(win32_attach_static_modules(&c) && events.size()==3 &&
+          loader_module_named("B.dll")->load_refs==2);
+    CHECK(c.r[R_ESP]==esp);
+    for(auto value:reserved_values)CHECK(value!=0 && value<GUEST_SIZE);
+    gm_put_str(0x00300000,"A.dll",16);
+    CHECK(invoke(&c,"LoadLibraryA",0x00300000)==a);
+    CHECK(events.size()==3 && loader_module_named("A.dll")->load_refs==2);
+    CHECK(invoke(&c,"FreeLibrary",a)==1 && events.size()==3);
+    win32_detach_process_modules(&c);
+    CHECK((events==std::vector<uint32_t>{b|1,d|1,a|1,a,d,b}));
+    for(auto value:reserved_values)CHECK(value!=0);
+    win32_detach_process_modules(&c);CHECK(events.size()==6);
+    CHECK(!loader_module_named("B.dll")->load_refs);
+    // Dynamic dependency acquisition and reverse release use NULL reserved.
+    events.clear();reserved_values.clear();
+    CHECK(invoke(&c,"LoadLibraryA",0x00300000)==a);
+    CHECK(invoke(&c,"FreeLibrary",a)==1);
+    CHECK((events==std::vector<uint32_t>{b|1,d|1,a|1,a,d,b}));
+    for(auto value:reserved_values)CHECK(value==0);
+    // A failing top-level entry unwinds the shared dependency closure once.
+    events.clear();reserved_values.clear();fail_base=a;
+    CHECK(invoke(&c,"LoadLibraryA",0x00300000)==0);
+    CHECK((events==std::vector<uint32_t>{b|1,d|1,a|1,a,d,b}));
+    CHECK(!loader_module_named("B.dll")->load_refs && !loader_module_named("A.dll")->attached);
+    // Failure of a nested dependency unwinds earlier acquisitions.
+    events.clear();reserved_values.clear();fail_base=d;
+    loader_test_modules(main,{ma,md,mb});
+    CHECK(!win32_attach_static_modules(&c));
+    CHECK((events==std::vector<uint32_t>{b|1,d|1,d,b}));
+    CHECK(!loader_module_named("B.dll")->attached);
+    // Roll back an earlier successful EXE root if a later root fails.
+    events.clear();reserved_values.clear();fail_base=a;
+    LoaderModule two_roots=main;two_roots.dependencies={"B.dll","A.dll"};
+    loader_test_modules(two_roots,{ma,md,mb});
+    CHECK(!win32_attach_static_modules(&c));
+    CHECK((events==std::vector<uint32_t>{b|1,d|1,a|1,a,d,b}));
+    CHECK(!loader_module_named("B.dll")->load_refs);
+    // A failed load must retain another caller's preexisting B reference.
+    loader_test_modules(main,{ma,md,mb});events.clear();fail_base=0;
+    gm_put_str(0x00300000,"B.dll",16);CHECK(invoke(&c,"LoadLibraryA",0x00300000)==b);
+    events.clear();fail_base=a;gm_put_str(0x00300000,"A.dll",16);
+    CHECK(invoke(&c,"LoadLibraryA",0x00300000)==0);
+    CHECK((events==std::vector<uint32_t>{d|1,a|1,a,d}));
+    CHECK(loader_module_named("B.dll")->load_refs==1 && loader_module_named("B.dll")->attached);
+    CHECK(invoke(&c,"FreeLibrary",b)==1);
+    fail_base=0;events.clear();
+    loader_module_named("B.dll")->dependencies={"A.dll"};
+    CHECK(!win32_attach_static_modules(&c) && events.empty());
+    CHECK(strstr(loader_error(),"cyclic")!=nullptr);
