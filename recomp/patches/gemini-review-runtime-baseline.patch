+void CT_GetDesc(X86 *c) {
+    ComObj *ct = com_this_arg(c);
+    uint32_t pDesc = arg(c, 1);
+    if (!ct || !pDesc) {
+        com_ret(c, D3DERR_INVALIDCALL);
+        return;
+    }
+    auto it = g_constant_tables.find(ct->id);
+    if (it == g_constant_tables.end()) {
+        memset(gm_ptr(pDesc), 0, 12);
+        com_ret(c, D3D_OK9);
+        return;
+    }
+    wr32(pDesc + 0, it->second.creator);
+    wr32(pDesc + 4, it->second.version);
+    wr32(pDesc + 8, it->second.constants_count);
+    com_ret(c, D3D_OK9);
+}
+
+void CT_GetConstant(X86 *c) {
+    ComObj *ct = com_this_arg(c);
+    uint32_t index = arg(c, 2);
+    if (!ct) {
+        set_eax(c, 0);
+        return;
+    }
+    auto it = g_constant_tables.find(ct->id);
+    if (it == g_constant_tables.end() || index >= it->second.constants_count) {
+        set_eax(c, 0);
+        return;
+    }
+    set_eax(c, index + 1);
+}
+
+void CT_GetConstantDesc(X86 *c) {
+    ComObj *ct = com_this_arg(c);
+    uint32_t hConstant = arg(c, 1);
+    uint32_t pDesc = arg(c, 2);
+    uint32_t pCount = arg(c, 3);
+    if (!ct || !pDesc || !hConstant) {
+        com_ret(c, D3DERR_INVALIDCALL);
+        return;
+    }
+    auto it = g_constant_tables.find(ct->id);
+    if (it == g_constant_tables.end()) {
+        com_ret(c, D3DERR_INVALIDCALL);
+        return;
+    }
+    uint32_t index = hConstant - 1;
+    if (index >= it->second.constants_count) {
+        com_ret(c, D3DERR_INVALIDCALL);
+        return;
+    }
+    uint32_t entry = it->second.info + index * 20u;
+    uint32_t name_off = rd32(entry);
+    uint16_t reg_set = rd16(entry + 4);
+    uint16_t reg_idx = rd16(entry + 6);
+    uint16_t reg_count = rd16(entry + 8);
+    
+    memset(gm_ptr(pDesc), 0, 48);
+    wr32(pDesc + 0, name_off ? it->second.ctab_base + name_off : 0);
+    wr32(pDesc + 4, (uint32_t)reg_set);
+    wr32(pDesc + 8, (uint32_t)reg_idx);
+    wr32(pDesc + 12, (uint32_t)reg_count);
+    if (pCount)
+        wr32(pCount, 1);
+    com_ret(c, D3D_OK9);
+}
+
+void CT_GetConstantByName(X86 *c) {
+    ComObj *ct = com_this_arg(c);
+    uint32_t pName = arg(c, 2);
+    if (!ct || !pName) {
+        set_eax(c, 0);
+        return;
+    }
+    auto it = g_constant_tables.find(ct->id);
+    if (it == g_constant_tables.end()) {
+        set_eax(c, 0);
+        return;
+    }
+    const char *target = (const char *)gm_ptr(pName);
+    for (uint32_t i = 0; i < it->second.constants_count; ++i) {
+        uint32_t entry = it->second.info + i * 20u;
+        uint32_t name_off = rd32(entry);
+        if (name_off) {
+            const char *name = (const char *)gm_ptr(it->second.ctab_base + name_off);
+            if (strcmp(target, name) == 0) {
+                set_eax(c, i + 1);
+                return;
+            }
+        }
+    }
+    set_eax(c, 0);
+}
