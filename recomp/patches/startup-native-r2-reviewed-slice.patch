diff --git a/runtime/tests/intrinsics_tests.cpp b/runtime/tests/intrinsics_tests.cpp
new file mode 100644
index 0000000..46e86a8
--- /dev/null
+++ b/runtime/tests/intrinsics_tests.cpp
@@ -0,0 +1,82 @@
+// Synthetic generated-call contract: no original executable or DLL is loaded.
+#include "../intrinsics.h"
+#include "../loader.h"
+#include "../memory.h"
+#include "../../platform/os.h"
+#include <cstdio>
+#include <cstring>
+#include <initializer_list>
+
+static int failures;
+#define CHECK(x)                                                                                   \
+    do {                                                                                           \
+        if (!(x)) {                                                                                \
+            ++failures;                                                                            \
+            fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x);                                   \
+        }                                                                                          \
+    } while (0)
+
+static void jump(X86 *c, uint32_t buffer, int value) {
+    c->r[R_ESP] -= 64;
+    wr32(c->r[R_ESP], 0x00403000);
+    wr32(c->r[R_ESP] + 4, buffer);
+    wr32(c->r[R_ESP] + 8, (uint32_t)value);
+    c->r[R_EBX] = 0xbadbad;
+    recomp_longjmp(c);
+    CHECK(false);
+}
+
+// Matches the translator's legal controlling-expression form exactly. The
+// context is owned by the caller, so longjmp does not invalidate its contents.
+static void roundtrip(X86 *c, uint32_t buffer, uint32_t sp, int value, bool nested) {
+    c->r[R_ESP] = sp;
+    c->r[R_EBX] = 0x12345678;
+    wr32(sp, 0x00402000);
+    wr32(sp + 4, buffer);
+    jmp_buf *env = recomp_setjmp_prepare(c);
+    if (setjmp(*env) == 0)
+        recomp_setjmp_return(c, 0);
+    else
+        recomp_setjmp_resume(c);
+    CHECK(c->r[R_ESP] == sp + 4);
+    CHECK(c->eip == 0x00402000);
+    CHECK(c->r[R_EBX] == 0x12345678);
+    if (c->r[R_EAX] == 0) {
+        if (nested) {
+            roundtrip(c, buffer + 256, sp - 256, -19, false);
+            CHECK((int32_t)c->r[R_EAX] == -19);
+        }
+        jump(c, buffer, value);
+    }
+    CHECK((int32_t)c->r[R_EAX] == (value ? value : 1));
+}
+
+int main(int argc, char **argv) {
+    mem_init();
+    X86 c{};
+    loader_init_context(&c);
+    if (argc > 1 && !strcmp(argv[1], "foreign-context")) {
+        c.r[R_ESP] = 0x0eff0000;
+        wr32(c.r[R_ESP], 0x00402000);
+        wr32(c.r[R_ESP] + 4, 0x02001000);
+        jmp_buf *env = recomp_setjmp_prepare(&c);
+        if (setjmp(*env) == 0) {
+            X86 other = c;
+            jump(&other, 0x02001000, 7);
+        }
+        return 3;
+    }
+    for (int value : {0, 1, 7, -7, (-2147483647 - 1)})
+        roundtrip(&c, 0x02001000, 0x0eff0000, value, true);
+    char exe[4096];
+    CHECK(os_exe_path(exe, sizeof exe) == 0);
+    const char *args[] = {exe, "foreign-context", nullptr};
+    int64_t pid = 0;
+    int code = -1;
+    CHECK(os_spawn(args, &pid) == 0 && os_wait(pid, &code) == 0 && code == 134);
+    mem_shutdown();
+    printf(
+        "intrinsics_tests: five nested return-value cases and foreign-context guard; failures=%d\n",
+        failures);
+    return failures ? 1 : 0;
+}
