+static void test_blur_cpu_volume() {
+    cpu_reset();
+    ComObj *device = com_new(K_D3D9DEVICE);
+    uint32_t dev = com_view(device, IF_D3DDEVICE9);
+    uint32_t out = sc(0x100), lock = sc(0x120);
+    CHECK_EQ(call_method(dev, 24, {32,32,32,1,0,21,1,out,0}), 0u);
+    uint32_t tex = rd32(out);
+    CHECK(tex != 0);
+    CHECK_EQ(call_method(tex, 13, {}), 1u);
+    CHECK_EQ(call_method(tex, 10, {}), 4u);
+    CHECK_EQ(call_method(tex, 17, {0,sc(0x140)}), 0u);
+    CHECK_EQ(rd32(sc(0x140)+24), 32u);
+    CHECK_EQ(call_method(tex, 19, {0,lock,0,0}), 0u);
+    CHECK_EQ(rd32(lock), 128u);
+    CHECK_EQ(rd32(lock+4), 4096u);
+    uint32_t bits = rd32(lock+8);
+    wr32(bits, 0x12345678); wr32(bits+131068, 0xaabbccdd);
+    CHECK_EQ(call_method(tex, 19, {0,lock,0,0}), 0x8876086cu);
+    CHECK_EQ(call_method(tex, 20, {0}), 0u);
+    CHECK_EQ(call_method(tex, 19, {0,lock,0,0}), 0u);
+    CHECK_EQ(rd32(rd32(lock+8)), 0x12345678u);
+    CHECK_EQ(rd32(rd32(lock+8)+131068), 0xaabbccddu);
+    CHECK_EQ(call_method(tex, 20, {0}), 0u);
+    CHECK_EQ(call_method(tex, 20, {0}), 0x8876086cu);
+    CHECK_EQ(call_method(tex, 19, {1,lock,0,0}), 0x8876086cu);
+    call_method(tex, 2, {});
+    wr32(out, 0xdeadbeef);
+    CHECK_EQ(call_method(dev, 24, {32,32,32,2,0,21,1,out,0}), 0x8876086au);
+    CHECK_EQ(rd32(out), 0u);
+    CHECK_EQ(call_method(dev, 24, {0xffffffff,32,32,1,0,21,1,out,0}), 0x8876086cu);
+    CHECK_EQ(call_method(dev, 24, {2,3,4,1,0,22,1,out,0}), 0u);
+    tex = rd32(out);
+    CHECK_EQ(call_method(tex, 19, {0,lock,0,0}), 0u);
+    CHECK_EQ(rd32(lock), 8u); CHECK_EQ(rd32(lock+4), 24u);
+    bits = rd32(lock+8);
+    CHECK(heap_owns(bits));
+    call_method(tex, 2, {}); // destruction while locked must free staging
+    CHECK(!heap_owns(bits));
+    CHECK_EQ(call_method(dev, 24, {64,16,64,1,0,50,1,out,0}), 0u);
+    tex = rd32(out);
+    CHECK_EQ(call_method(tex, 19, {0,lock,0,0}), 0u);
+    CHECK_EQ(rd32(lock), 64u); CHECK_EQ(rd32(lock+4), 1024u);
+    bits = rd32(lock+8); wr8(bits+65535, 0x7d);
+    CHECK_EQ(call_method(tex, 20, {0}), 0u);
+    CHECK_EQ(call_method(tex, 19, {0,lock,0,0}), 0u);
+    CHECK_EQ(rd8(rd32(lock+8)+65535), 0x7du);
+    CHECK_EQ(call_method(tex, 20, {0}), 0u);
+    call_method(tex, 2, {});
+    call_method(dev, 2, {});
+}
