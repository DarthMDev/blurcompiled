+// New bounded CPU volume adapter: one A8R8G8B8/X8R8G8B8/L8 level.
+// GPU volume sampling and IDirect3DVolume9 views remain unsupported.
+struct Volume9 {
+    uint32_t depth, pool;
+    bool locked = false;
+};
+static std::unordered_map<uint32_t, Volume9> volumes9;
+void Dev_CreateVolumeTexture(X86 *c) {
+    uint32_t out = arg(c, 8), w = arg(c, 1), h = arg(c, 2), d = arg(c, 3);
+    ComObj *dev = this_device9(c);
+    if (out) com_out_ptr(out, 0);
+    if (!dev || !out || !w || !h || !d || w > 256 || h > 256 || d > 256) {
+        com_ret(c, D3DERR_INVALIDCALL); return;
+    }
+    // Refuse contracts outside this slice instead of returning empty success.
+    if (arg(c, 4) != 1 || arg(c, 5) != 0 ||
+        (arg(c, 6) != 21 && arg(c, 6) != 22 && arg(c, 6) != 50) || arg(c, 7) > 3 || arg(c, 9)) {
+        com_ret(c, D3DERR_NOTAVAILABLE); return;
+    }
+    ComObj *o = com_new(K_D3D9TEXTURE);
+    if (!o) { com_ret(c, E_OUTOFMEMORY); return; }
+    o->dev_d3d = dev->id; o->width = w; o->height = h;
+    uint32_t bytes = arg(c, 6) == 50 ? 1 : 4;
+    o->bpp = bytes * 8; o->pitch = w * bytes; o->rmask = arg(c, 6);
+    if (!resource_alloc(o, w * h * d * bytes)) {
+        com_release(o); com_ret(c, E_OUTOFMEMORY); return;
+    }
+    volumes9.emplace(o->id, Volume9{d, arg(c, 7)});
+    uint32_t view = com_view(o, IF_D3DVOLUMETEXTURE9);
+    if (!view) { com_release(o); com_ret(c, E_OUTOFMEMORY); return; }
+    com_out_ptr(out, view);
+    LOGW("d3d9: CPU volume %ux%ux%u fmt=%u view=%08x", w, h, d, o->rmask, view);
+    com_ret(c, D3D_OK9);
+}
+static ComObj *volume_this(X86 *c) {
+    ComObj *o = com_this_arg(c);
+    return o && volumes9.count(o->id) ? o : nullptr;
+}
+void Vol_GetType(X86 *c) { set_eax(c, volume_this(c) ? 4 : 0); }
+void Vol_GetLevelCount(X86 *c) { set_eax(c, volume_this(c) ? 1 : 0); }
+void Vol_Unsupported(X86 *c) { com_ret(c, D3DERR_NOTAVAILABLE); }
+void Vol_GetVolumeLevel(X86 *c) {
+    if (arg(c, 2)) com_out_ptr(arg(c, 2), 0);
+    com_ret(c, D3DERR_NOTAVAILABLE);
+}
+void Vol_GetLevelDesc(X86 *c) {
+    ComObj *o = volume_this(c); uint32_t out = arg(c, 2);
+    if (!o || arg(c, 1) || !out) { com_ret(c, D3DERR_INVALIDCALL); return; }
+    wr32(out, o->rmask); wr32(out + 4, 2); // D3DRTYPE_VOLUME
+    wr32(out + 8, 0); wr32(out + 12, volumes9.at(o->id).pool);
+    wr32(out + 16, o->width); wr32(out + 20, o->height);
+    wr32(out + 24, volumes9.at(o->id).depth);
+    com_ret(c, D3D_OK9);
+}
+void Vol_LockBox(X86 *c) {
+    ComObj *o = volume_this(c); uint32_t out = arg(c, 2);
+    // Whole-level locks with zero flags are the verified startup contract.
+    if (!o || !out || arg(c, 1) || arg(c, 3) || arg(c, 4) || volumes9.at(o->id).locked) {
+        com_ret(c, D3DERR_INVALIDCALL); return;
+    }
+    uint32_t pixels = heap_alloc(o->pixels_bytes, false, 16);
+    if (!pixels) { com_ret(c, E_OUTOFMEMORY); return; }
+    memcpy(gm_ptr(pixels), o->blob.data(), o->pixels_bytes);
+    o->pixels = pixels; volumes9.at(o->id).locked = true;
+    wr32(out, o->pitch); wr32(out + 4, o->pitch * o->height); wr32(out + 8, pixels);
+    com_ret(c, D3D_OK9);
+}
+void Vol_UnlockBox(X86 *c) {
+    ComObj *o = volume_this(c);
+    if (!o || arg(c, 1) || !volumes9.at(o->id).locked) {
+        com_ret(c, D3DERR_INVALIDCALL); return;
+    }
+    memcpy(o->blob.data(), gm_ptr(o->pixels), o->pixels_bytes);
+    heap_free(o->pixels); o->pixels = 0; volumes9.at(o->id).locked = false;
+    LOGW("d3d9: CPU volume upload retained %u bytes", o->pixels_bytes);
+    com_ret(c, D3D_OK9);
+}
+
+static void volume_forget(uint32_t id) { volumes9.erase(id); }
